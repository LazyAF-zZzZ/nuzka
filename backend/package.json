{
  "name": "rov-overlay-backend",
  "version": "3.2.1",
  "description": "Backend for Nuzka: HTTP API, Socket.IO and the OBS overlays. The operator UI is the WPF app in ../desktop.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "node tools/check-web-types.js",
    "start": "npm run build && node server.js",
    "serve": "npm run build && node server.js",
    "dev": "nodemon --watch server -e ts --exec \"npm run build && node server.js\"",
    "check": "node tools/check-syntax.js",
    "test": "npm run build && node --test \"build/tests/**/*.test.js\"",
    "check-heroes": "node check-heroes.js"
  },
  "keywords": [
    "rov",
    "arena of valor",
    "overlay",
    "draft pick"
  ],
  "author": "LazyAF",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "nodemon": "^2.0.22",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
