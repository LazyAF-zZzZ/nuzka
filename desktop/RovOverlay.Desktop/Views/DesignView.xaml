<UserControl x:Class="RovOverlay.Desktop.Views.DesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding OpenPreviewCommand}" ToolTip="{svc:T Design.PreviewTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="{svc:T Design.Preview}"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{svc:T Design.Title}"/>
                    <Border Style="{StaticResource Pill}" Margin="10,2,0,0">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding PreviewSizeText}"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Layout -->
            <DockPanel Margin="0,20,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{svc:T Layout.Reset}"
                        Command="{Binding ResetLayoutCommand}" Padding="10,0"/>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Layout.Title}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding EditLayoutCommand}"
                            VerticalAlignment="Center" Margin="16,0,0,0" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C2;" FontSize="12" Margin="0,0,7,0"/>
                            <TextBlock Text="{svc:T Layout.Edit}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding LayoutScenes}" SelectedItem="{Binding LayoutScene}"
                                  HorizontalAlignment="Left" MinWidth="320" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding LayoutStatus}" FontWeight="SemiBold"/>
                        <TextBlock Text="{svc:T Layout.Hint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Team list -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T TeamList.Title}" Margin="0,20,0,8"/>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="−" Width="34" Padding="0" AutomationProperties.Name="{svc:T TeamList.Fewer}" ToolTip="{svc:T TeamList.Fewer}"
                                Command="{Binding PerSetDownCommand}"/>
                        <TextBox x:Name="PerSetBox" AutomationProperties.Name="{svc:T TeamList.PerSet}" Width="56" Margin="6,0" TextAlignment="Center" VerticalContentAlignment="Center"
                                 Text="{Binding PerSetText, UpdateSourceTrigger=Explicit}"
                                 GotKeyboardFocus="PerSetBox_GotFocus" LostKeyboardFocus="PerSetBox_LostFocus" KeyDown="PerSetBox_KeyDown"/>
                        <Button Style="{StaticResource GhostButton}" Content="+" Width="34" Padding="0" AutomationProperties.Name="{svc:T TeamList.More}" ToolTip="{svc:T TeamList.More}"
                                Command="{Binding PerSetUpCommand}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{svc:T TeamList.PerSet}" FontWeight="SemiBold"/>
                        <TextBlock Text="{svc:T TeamList.PerSetHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Theme -->
            <DockPanel Margin="0,20,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{svc:T Design.ResetTheme}"
                        Command="{Binding ResetThemeCommand}" Padding="10,0"/>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Design.Theme}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Colors}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,10,0">
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hex}" FontSize="10.5"
                                                   FontFamily="{StaticResource MonoFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <Grid>
                                        <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"
                                                 Padding="34,4,7,4" FontFamily="{StaticResource MonoFont}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Border Width="20" Height="20" CornerRadius="3" Margin="6,0,0,0" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Background="{Binding Swatch}"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Numbers}" Margin="0,16,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" TextAlignment="Right"
                                               FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Design.ThemeHint}" FontSize="11.5" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Background images -->
            <DockPanel Margin="0,22,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="{svc:T Design.UseImages}" IsChecked="{Binding SkinEnabled}" Margin="0,0,16,0"/>
                    <CheckBox Content="{svc:T Design.ShowPanels}" IsChecked="{Binding ShowPanels}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Design.Images}" VerticalAlignment="Center"/>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,10,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RatioText}" FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="{Binding Group, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Part, Mode=OneWay}"
                                            Foreground="{StaticResource TextBrush}"/>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource MonoText}" FontSize="11.5" Margin="0,6,0,0"
                                           Foreground="{StaticResource GoldBrush}"/>
                                <TextBlock Text="{Binding FileText}" Style="{StaticResource MonoText}" FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <Border Height="84" Margin="0,8,0,0" CornerRadius="4" Background="{StaticResource Surface0Brush}"
                                        BorderThickness="1" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldLineBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{svc:T Design.NoImage}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisInv}}"/>
                                        <Image Source="{Binding PreviewUrl, Converter={StaticResource UrlToImage}}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{svc:T Design.Upload}" Command="{Binding UploadCommand}" Padding="12,0"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{svc:T Design.Clear}"
                                            Command="{Binding ClearCommand}" Margin="6,0,0,0" Padding="12,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Design.Foot}" FontSize="11.5" Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
