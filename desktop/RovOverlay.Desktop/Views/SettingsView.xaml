<UserControl x:Class="RovOverlay.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services">
    <UserControl.Resources>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,24" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{svc:T Nav.Settings}"/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Settings.Language}" Margin="0,22,0,8"/>
            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="ไทย"
                                 IsChecked="{Binding Language, Converter={StaticResource EqualsToBool}, ConverterParameter=th}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="English"
                                 IsChecked="{Binding Language, Converter={StaticResource EqualsToBool}, ConverterParameter=en}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Supporter.Section}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Supporter.Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE735;" FontSize="14" Margin="0,0,8,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}"
                                   Visibility="{Binding Supporter.IsSupporter, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Right" Content="{svc:T Supporter.Remove}" Command="{Binding Supporter.RemoveKeyCommand}"
                                Margin="8,0,0,0" Visibility="{Binding Supporter.HasKey, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Supporter.Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{svc:T Supporter.Use}"
                                Command="{Binding Supporter.UseKeyCommand}" Margin="8,0,0,0" MinWidth="110"/>
                        <Grid>
                            <TextBox x:Name="KeyBox" Text="{Binding Supporter.KeyInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                            <TextBlock Text="{svc:T Supporter.Paste}" IsHitTestVisible="False" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=KeyBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <Button Command="{Binding OpenSupportCommand}" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEB51;" FontSize="12" Margin="0,0,7,0"/>
                            <TextBlock Text="{svc:T Supporter.Become}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Settings.Backup}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Backup.Hint}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveBackupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Text="{svc:T Backup.Save}"/>
                            </StackPanel>
                        </Button>
                        <Button Content="{svc:T Backup.RestoreButton}" Command="{Binding RestoreCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Automatic backups: the newest five, each with Restore -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                Command="{Binding RefreshAutoBackupsCommand}" ToolTip="{svc:T Common.Refresh}"/>
                        <TextBlock Text="{svc:T AutoBackup.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T AutoBackup.Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="{svc:T AutoBackup.None}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasAutoBackups, Converter={StaticResource BoolToVisInv}}"/>
                    <ItemsControl ItemsSource="{Binding AutoBackups}" Focusable="False"
                                  Visibility="{Binding HasAutoBackups, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="{svc:T Backup.Restore}" Command="{Binding RestoreCommand}"
                                            MinWidth="84" Margin="10,0,0,0"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding WhenText}" Width="190" VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    <TextBlock Text="{Binding ContentsText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Left" Command="{Binding OpenBackupFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Text="{svc:T AutoBackup.OpenFolder}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding MoreBackupsText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Update.Section}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Update.Hint}" Margin="0,0,0,10"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{svc:T Update.CheckNow}" Command="{Binding CheckUpdateCommand}"
                                Margin="8,0,0,0" MinWidth="110"/>
                        <TextBlock Text="{Binding Updates.Status}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ProgressBar Height="3" Margin="0,10,0,0" BorderThickness="0" Maximum="100"
                                 Value="{Binding Updates.Percent, Mode=OneWay}"
                                 Background="{StaticResource Surface3Brush}" Foreground="{StaticResource GoldBrush}"
                                 Visibility="{Binding Updates.ShowProgress, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Update.Channel}" Margin="0,16,0,6"/>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="channel" Content="{svc:T Update.Stable}"
                                         IsChecked="{Binding UpdateChannel, Converter={StaticResource EqualsToBool}, ConverterParameter=stable}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="channel" Content="{svc:T Update.Beta}"
                                         IsChecked="{Binding UpdateChannel, Converter={StaticResource EqualsToBool}, ConverterParameter=beta}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{svc:T Update.ChannelHint}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Settings.Server}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource KeyText}" Text="{svc:T Settings.Address}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding ServerUrl}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource KeyText}" Text="{svc:T Settings.Mode}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModeText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource KeyText}" Text="{svc:T Settings.Node}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding NodePath}"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource KeyText}" Text="{svc:T Settings.Backend}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding BackendDir}"/>
                </Grid>
            </Border>

            <DockPanel Margin="0,24,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        Command="{Binding RefreshLogCommand}" ToolTip="{svc:T Common.Refresh}"/>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Settings.Log}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="240" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Settings.About}" Margin="0,24,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource KeyText}" Text="{svc:T Settings.Version}" Width="150"/>
                <TextBlock Style="{StaticResource ValueText}" Text="{Binding Version}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Settings.Disclaimer}" TextWrapping="Wrap"
                       FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
