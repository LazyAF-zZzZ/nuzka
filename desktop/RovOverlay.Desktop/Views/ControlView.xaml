<UserControl x:Class="RovOverlay.Desktop.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services"
             xmlns:ctl="clr-namespace:RovOverlay.Desktop.Views.Controls">
    <UserControl.Resources>
        <!-- One side of the board. DataContext: a SideViewModel.

             Two layouts in one template, switched by the panel's ShowSetup. Set-up shows
             everything that is typed before the draft (name, registry, logo, nicknames,
             lanes). Draft hides those and leaves the picks the room. The hero box is the same
             element in both, never a second copy: two pickers bound to one slot would both
             answer the "focus the slot the draft is waiting on" request. -->
        <DataTemplate x:Key="SidePanel">
            <Border Style="{StaticResource Card}">
                <Border.Resources>
                    <Style x:Key="SideAccent" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBlue}" Value="False">
                                <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SideTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                        <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBlue}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <!-- Visible in set-up, collapsed during the draft. -->
                    <Style x:Key="SetupOnly" TargetType="FrameworkElement">
                        <Setter Property="Visibility" Value="{Binding DataContext.ShowSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                    </Style>
                    <Style x:Key="DraftOnly" TargetType="FrameworkElement">
                        <Setter Property="Visibility" Value="{Binding DataContext.ShowSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}"/>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <Border Height="2" Style="{StaticResource SideAccent}" CornerRadius="6,6,0,0"/>
                    <DockPanel Margin="14,10,12,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{svc:T Control.Score}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- -1: take back the last game this side won. Greyed out and
                                 unpressable at 0; the tooltip still explains it when disabled. -->
                            <Button Content="{svc:T Flow.RemovePoint}" Margin="0,0,6,0"
                                    MinWidth="40" Height="34" FontSize="14" FontWeight="Bold" Padding="8,0"
                                    Command="{Binding RemovePointCommand}" IsEnabled="{Binding CanRemovePoint}"
                                    ToolTip="{svc:T Flow.RemovePointTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="{Binding RemovePointName}"/>
                            <!-- Typing here corrects the score and never moves the board. -->
                            <TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}" Width="54" MaxLength="2"
                                     FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                            <!-- +1: this side won the game. The winner is counted from the score,
                                 and the series is declared when a side reaches the wins it needs. -->
                            <Button Style="{StaticResource PrimaryButton}" Content="{svc:T Flow.AddPoint}" Margin="6,0,0,0"
                                    MinWidth="44" Height="34" FontSize="14" FontWeight="Bold" Padding="8,0"
                                    Command="{Binding AddPointCommand}" ToolTip="{svc:T Flow.AddPointTip}"
                                    AutomationProperties.Name="{Binding AddPointName}"/>
                        </StackPanel>
                        <!-- During the draft the side is identified by its logo and name, read-only. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Style="{StaticResource DraftOnly}">
                            <Border Width="30" Height="30" CornerRadius="4" Margin="0,0,10,0"
                                    Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                <Image Source="{Binding LogoUrl, Converter={StaticResource UrlToImage}}" Stretch="Uniform" Margin="2"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SideTitle}"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SideTitle}">
                                    <Setter Property="Visibility" Value="{Binding DataContext.ShowSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <Grid Margin="14,0,12,10" Style="{StaticResource SetupOnly}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.RowSpan="2" Width="52" Height="52" CornerRadius="5" VerticalAlignment="Top"
                                Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" ToolTip="{svc:T Control.LogoHint}">
                            <Image Source="{Binding LogoUrl, Converter={StaticResource UrlToImage}}" Stretch="Uniform" Margin="3"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Control.TeamName}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Control.FromRegistry}"/>
                            <ComboBox ItemsSource="{Binding Owner.Teams}" SelectedItem="{Binding LoadTeam}"
                                      DisplayMemberPath="Label" ToolTip="{svc:T Control.FromRegistryTip}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10,8,0,0">
                            <Button Content="{svc:T Control.Upload}" Command="{Binding UploadLogoCommand}" Padding="10,0"/>
                            <Button Content="{svc:T Control.ClearLogo}" Command="{Binding ClearLogoCommand}" Margin="6,0,0,0" Padding="10,0"/>
                            <TextBlock Text="{Binding SaveText}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Saved}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Visible, not only a tooltip: v2 showed the size under the buttons, and
                             an operator uploading a 64 px logo only finds out on air. -->
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,6,0,0"
                                   Text="{svc:T Control.LogoSize}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Players and picks. The lane and player-swap columns are Auto, so when
                         their contents collapse during the draft the nickname and the pick
                         share the width they leave. The header uses the same widths. -->
                    <Grid Margin="14,0,12,0" TextElement.Foreground="{StaticResource MutedBrush}" TextElement.FontSize="10.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#"/>
                        <TextBlock Grid.Column="1" Text="{svc:T Control.Nickname}" Margin="4,0"/>
                        <TextBlock Grid.Column="2" Text="{svc:T Control.Lane}" Width="116" Margin="4,0" Style="{StaticResource SetupOnly}"/>
                        <Border Grid.Column="3" Width="38" Style="{StaticResource SetupOnly}"/>
                        <TextBlock Grid.Column="4" Text="{svc:T Control.HeroPick}" Margin="4,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="14,4,12,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Player.Number}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <!-- DataContext first, then plain property paths: binding "Player.Name" while
                                         also setting DataContext to Player looks for Player.Player.Name (§9). -->
                                    <TextBox Grid.Column="1" Margin="4,0" DataContext="{Binding Player}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="24" Tag="{Binding Placeholder}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="{Binding DataContext.ShowSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center" Text="{Binding Player.Name}"
                                               TextTrimming="CharacterEllipsis" Style="{StaticResource DraftOnly}"/>
                                    <ComboBox Grid.Column="2" Margin="4,0" Width="116" DataContext="{Binding Player}" ItemsSource="{Binding Positions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="{Binding DataContext.ShowSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <Button Grid.Column="3" Width="38" DataContext="{Binding Player}"
                                            Command="{Binding SwapCommand}" Padding="0" ToolTip="{svc:T Control.SwapPlayerTip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <!-- A swap icon rather than "SW", which said nothing about what it did.
                                                     While armed it turns into a red cross that cancels. -->
                                                <Setter Property="Content" Value="&#xE8AB;"/>
                                                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Visibility" Value="{Binding DataContext.ShowSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSwapping}" Value="True">
                                                        <Setter Property="Content" Value="{Binding SwapLabel}"/>
                                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <ctl:HeroPickerView Grid.Column="4" Margin="4,0" DataContext="{Binding Pick}"/>
                                    <Button Grid.Column="5" Content="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="12" Padding="0"
                                            ToolTip="{svc:T Control.SwapPickTip}" CommandParameter="{Binding Pick}"
                                            Command="{Binding DataContext.SwapPickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bans -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="14,10,12,0" Padding="0,10,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Control.Ban}" Margin="0,0,0,7"/>
                            <ItemsControl ItemsSource="{Binding Bans}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <ctl:HeroPickerView/>
                                            <Button Style="{StaticResource GhostButton}" Content="{svc:T Control.ClearSlot}" FontSize="10"
                                                    Command="{Binding ClearCommand}" MinHeight="20" Padding="0" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ========== Bottom bar: always reachable ==========
             Safe actions on the left, the one that wipes the whole match alone at the far
             right. UNDO is not gold: gold means the main action or what is live, and undo
             is neither. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="False">
                <Button Command="{Binding UndoCommand}" MinWidth="96">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="{svc:T Control.Undo}"/>
                    </StackPanel>
                </Button>
                <Button Content="{svc:T Control.SwitchTeams}" Command="{Binding SwitchTeamsCommand}" Margin="8,0,0,0"/>
                <Rectangle Width="1" Margin="14,2" Fill="{StaticResource BorderBrush}"/>
                <Button Style="{StaticResource DangerButton}" Content="{svc:T Control.ClearPicksBans}" Command="{Binding ClearAllCommand}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Muted2Brush}"/>

                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{svc:T Control.ResetMatch}"
                        Command="{Binding ResetMatchCommand}"/>
                <Rectangle DockPanel.Dock="Right" Width="1" Margin="14,2" Fill="{StaticResource BorderBrush}"/>
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Hints}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="5,0,5,1">
                                    <TextBlock Text="{Binding Keys}" FontSize="10.5" Foreground="{StaticResource Muted2Brush}"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12,14,16">
                <!-- ========== Match info and the on-air switches ========== -->
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="210">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Control.Tournament}"/>
                                <TextBox Text="{Binding Tournament, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                            </StackPanel>
                            <!-- Wide enough for "TEAM A VS TEAM B : GAME 1" without clipping
                                 mid-word. This is what the operator reads back before going
                                 on air, so the tooltip carries the whole thing regardless. -->
                            <StackPanel Width="440" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Control.MatchTitle}"/>
                                <TextBox Text="{Binding MatchTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                         ToolTip="{Binding MatchTitle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MatchSaveText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Bottom" Margin="12,0,0,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border Style="{StaticResource SegmentGroup}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{svc:T Control.Size}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <Button Content="1080p" Padding="11,0" MinHeight="24" CommandParameter="1080"
                                            Command="{Binding SetSizeCommand}" ToolTip="{svc:T Control.Size1080Tip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Is1080}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                                                        <Setter Property="Foreground" Value="#15120B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="1440p" Padding="11,0" MinHeight="24" CommandParameter="1440"
                                            Command="{Binding SetSizeCommand}" ToolTip="{svc:T Control.Size1440Tip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Is1440}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                                                        <Setter Property="Foreground" Value="#15120B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{svc:T Control.Banner}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <Button Content="{svc:T Control.Show}" Padding="11,0" MinHeight="24" Command="{Binding ShowBannerCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BannerOn}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                                                        <Setter Property="Foreground" Value="#15120B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{svc:T Control.Hide}" Padding="11,0" MinHeight="24" Command="{Binding HideBannerCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BannerOn}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                                        <Setter Property="Foreground" Value="#15120B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The tournament match this panel is driving -->
                <Border Background="{StaticResource GoldSoftBrush}" BorderBrush="{StaticResource GoldLineBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,7" Margin="0,10,0,0"
                        Visibility="{Binding HasLive, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <!-- One click back to the bracket this match came from. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0"
                                Content="{svc:T Live.OpenBracket}" Command="{Binding OpenBracketCommand}"
                                Visibility="{Binding HasLiveBracket, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{svc:T Control.OnAir}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource GoldBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LiveText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- The series just ended: say so, and offer the next match right here. -->
                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,7" Margin="0,8,0,0"
                        Visibility="{Binding SeriesOver, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,0" Command="{Binding PutNextOnAirCommand}"
                                Visibility="{Binding HasNextMatch, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Margin="0,0,7,0"/>
                                <TextBlock Text="{svc:T Flow.PutOnAir}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{svc:T Flow.SeriesOver}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource GoldBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SeriesResultText}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="·" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding NextMatchText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted2Brush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- ========== Draft ========== -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Height="2" Background="{StaticResource GoldLineBrush}" CornerRadius="6,6,0,0"/>
                        <DockPanel Margin="14,10,12,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{svc:T Control.Round}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="&#x2039;" FontSize="16" Padding="8,0" MinHeight="24"
                                            Command="{Binding StepRoundCommand}" CommandParameter="-1" IsEnabled="{Binding CanPrevRound}"
                                            ToolTip="{svc:T Control.PrevRoundTip}"/>
                                    <TextBlock Text="{Binding RoundText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                                               MinWidth="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource GhostButton}" Content="&#x203A;" FontSize="16" Padding="8,0" MinHeight="24"
                                            Command="{Binding StepRoundCommand}" CommandParameter="1" ToolTip="{svc:T Control.NextRoundTip}"/>
                                    <TextBlock Text="{Binding RoundNote}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="6,0,8,0"/>
                                    <Rectangle Width="1" Margin="2,5,10,5" Fill="{StaticResource BorderBrush}"/>
                                    <CheckBox Content="{svc:T Flow.SwapSides}" IsChecked="{Binding SwapSidesEachRound, Mode=TwoWay}"
                                              ToolTip="{svc:T Flow.SwapSidesTip}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Control.DraftTimer}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="14,0,12,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PhaseLabel}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TimerText}" FontSize="42" FontWeight="Light" HorizontalAlignment="Center"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Style.Triggers>
                                                <!-- Under ten seconds the clock pulses. This one is not
                                                     decoration: the operator is watching the teams and the
                                                     draft board, and movement is what peripheral vision
                                                     catches when a colour change does not. -->
                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="UrgentPulse">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1" To="0.35" Duration="0:0:0.5"
                                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="UrgentPulse"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding PhaseIndexText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Sequence}" Margin="16,0" VerticalAlignment="Center" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="999" Padding="9,2,9,3" Margin="0,0,4,4" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="#15120B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- START on its own row; the clock reset moved to the far end of the
                                 row below, away from it. They sat side by side, and a reset
                                 mid-draft throws the phase back to the start on air. -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Content="{svc:T Control.Start}" Command="{Binding StartCommand}" MinHeight="32"/>
                                <UniformGrid Columns="4" Margin="0,6,0,0" TextElement.FontSize="11">
                                    <Button Content="{svc:T Control.Prev}" Command="{Binding PrevCommand}" Margin="0,0,6,0" MinHeight="30" Padding="2,0"/>
                                    <Button Content="{Binding PauseResumeText}" Command="{Binding TogglePauseCommand}" Margin="0,0,6,0" MinHeight="30" Padding="2,0"/>
                                    <Button Content="{svc:T Control.Next}" Command="{Binding NextCommand}" Margin="0,0,6,0" MinHeight="30" Padding="2,0"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{svc:T Control.ResetDraft}"
                                            Command="{Binding ResetDraftCommand}" MinHeight="30" Padding="2,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== The two sides ========== -->
                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0"
                            Command="{Binding ToggleSetupCommand}" ToolTip="{svc:T Flow.TeamSetupTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{svc:T Flow.TeamSetup}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding ShowSetup, Converter={StaticResource FoldGlyph}}"
                                       FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Blue}" ContentTemplate="{StaticResource SidePanel}"/>
                    <ContentControl Grid.Column="2" Content="{Binding Red}" ContentTemplate="{StaticResource SidePanel}"/>
                </Grid>

                <!-- ========== Sound ========== -->
                <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,10,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleSoundCommand}"
                                    Content="{Binding ShowSound, Converter={StaticResource FoldGlyph}}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{svc:T Control.SoundNote}" FontSize="11" Margin="0,0,10,0"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding ShowSound, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Control.Sound}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SfxRows}" Focusable="False" Margin="0,6,0,0"
                                      Visibility="{Binding ShowSound, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="{Binding Note}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding Value}" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" TextAlignment="Right"
                                                   Style="{StaticResource MonoText}" Foreground="{StaticResource Muted2Brush}"/>
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="{svc:T Control.Test}"
                                                Command="{Binding TestCommand}" Margin="10,0,0,0" Padding="12,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
