<UserControl x:Class="RovOverlay.Desktop.Views.Controls.HeroPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services">
    <!-- DataContext: a HeroSlot. The box holds the typed text; the list below it shows
         heroes still free, newest filter first, with their portraits. -->
    <Grid>
        <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{Binding Label}" MinHeight="30" VerticalContentAlignment="Center"
                 GotKeyboardFocus="Box_GotFocus" LostKeyboardFocus="Box_LostFocus" PreviewKeyDown="Box_PreviewKeyDown">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Padding" Value="7,4"/>
                    <Style.Triggers>
                        <!-- Gold border: the draft is waiting on this slot -->
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasHero}" Value="True">
                            <Setter Property="Padding" Value="34,4,7,4"/>
                        </DataTrigger>
                        <!-- Last, so it wins: room on the right for the confirm button,
                             but not so much that the hero's name is squeezed out. Knowing
                             which hero is waiting matters more than the word "confirm". -->
                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                            <Setter Property="Padding" Value="34,4,36,4"/>
                            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <Image Source="{Binding IconUrl, Converter={StaticResource UrlToImage}}" Width="22" Height="22" Margin="6,0,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}"/>

        <!-- Chosen but not locked in. The overlay is already showing this hero, silently;
             this is the button that lets the sound and the animation play. Bans never
             reach this state, so the button never appears on one. -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                Padding="0" MinHeight="24" MinWidth="0" Width="26" FontSize="12"
                Style="{StaticResource PrimaryButton}" FontFamily="{StaticResource IconFont}"
                Content="&#xE73E;" ToolTip="{svc:T Control.ConfirmPickTip}"
                Command="{Binding ConfirmCommand}"
                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"/>

        <Popup x:Name="SuggestionPopup" IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="None" MaxHeight="340">
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="3" Margin="0,2,0,0"
                    MinWidth="{Binding ActualWidth, ElementName=Box}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <ListBox x:Name="List" ItemsSource="{Binding Suggestions}" SelectedIndex="{Binding Highlight}"
                         Background="Transparent" BorderThickness="0" MaxHeight="320"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseLeftButtonDown="List_MouseDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="5,3"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource OnGoldBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconUrl, Converter={StaticResource UrlToImage}}" Width="26" Height="26"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="9,0,4,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
