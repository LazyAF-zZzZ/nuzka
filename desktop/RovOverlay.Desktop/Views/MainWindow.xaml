<Window x:Class="RovOverlay.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:RovOverlay.Desktop.Services"
        Title="Nuzka" Width="1360" Height="840" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- A maximized chrome-less window overhangs the screen by the resize border; pad it back in. -->
    <Border x:Name="Root" Background="{StaticResource BgBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ========== Title bar ========== -->
            <Border Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NUZKA" FontWeight="Bold" FontSize="13" Foreground="{StaticResource GoldBrush}"/>
                    </StackPanel>

                    <!-- What the viewers see right now -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="3" Padding="7,1,7,2" Margin="0,0,14,0" ToolTip="{Binding BannerTip}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerOnAir}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding BannerText}" FontSize="10.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BannerOnAir}" Value="True">
                                                <Setter Property="Foreground" Value="#15120B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding BlueName}" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold"
                                   MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Margin="10,0" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalAlignment="Center">
                            <Run Text="{Binding BlueScore, Mode=OneWay}"/><Run Text=" – " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding RedScore, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding RedName}" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold"
                                   MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="14" Fill="{StaticResource BorderStrongBrush}" Margin="14,0"/>
                        <TextBlock Text="{Binding LiveMatchText}" Foreground="{StaticResource Muted2Brush}"
                                   MaxWidth="340" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Pill}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding OverlaySizeText}" FontSize="10.5" Foreground="{StaticResource Muted2Brush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <!-- A downloaded update. Click it to read what changed and choose. -->
                        <Button Style="{StaticResource GhostButton}" Padding="6,0" Margin="0,0,6,0" MinWidth="0"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ShowUpdateCommand}" ToolTip="{Binding Updates.Status}"
                                Visibility="{Binding Updates.IsReady, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Pill}" Padding="8,1,8,2" Background="{StaticResource GoldBrush}">
                                <TextBlock Text="{Binding Updates.ReadyVersion, StringFormat=v{0}}" FontSize="10.5"
                                           FontWeight="Bold" Foreground="#15120B"/>
                            </Border>
                        </Button>

                        <!-- Messages from the maker. Hidden when there are none. -->
                        <Button x:Name="BellButton" Style="{StaticResource GhostButton}" Padding="10,0"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ToggleNoticesCommand}" ToolTip="{svc:T Notices.Tip}"
                                Visibility="{Binding Notices.HasNotices, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E7;" FontSize="13"/>
                                <Border Style="{StaticResource Pill}" Margin="7,0,0,0" Padding="6,0,6,1"
                                        Background="{StaticResource GoldBrush}">
                                    <TextBlock Text="{Binding Notices.Count}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="#15120B"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ObsButton" Style="{StaticResource GhostButton}" Padding="10,0"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ToggleObsCommand}" ToolTip="{svc:T Obs.Tip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="13" Margin="0,0,7,0"/>
                                <TextBlock Text="{svc:T Obs.Button}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="10,0" MinWidth="40"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ToggleLanguageCommand}" Content="{Binding LanguageCode}"
                                ToolTip="{svc:T Lang.Tip}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE921;" Click="Minimize_Click"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE922;" Click="Maximize_Click"/>
                        <Button Style="{StaticResource CloseCaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE8BB;" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- OBS browser-source list -->
            <Popup PlacementTarget="{Binding ElementName=ObsButton}" Placement="Bottom" VerticalOffset="4"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{Binding IsObsOpen, Mode=TwoWay}">
                <Border Width="600" Padding="14" Margin="0,0,14,14" CornerRadius="6" BorderThickness="1"
                        Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <StackPanel TextElement.Foreground="{StaticResource TextBrush}">
                        <TextBlock Text="{svc:T Obs.Title}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{svc:T Obs.Hint}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,10"/>
                        <ItemsControl ItemsSource="{Binding ObsSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <!-- Which sources actually carry the draft sounds -->
                                                    <Border CornerRadius="8" Padding="6,0,6,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                            Background="{StaticResource GoldSoftBrush}"
                                                            Visibility="{Binding HasSfx, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{svc:T Obs.Sfx}" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource GoldBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" Margin="8,0"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                                        Command="{Binding CopyCommand}" ToolTip="{svc:T Common.Copy}"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;"
                                                        Command="{Binding OpenCommand}" ToolTip="{svc:T Common.OpenBrowser}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The two things that make sound look broken when it is not -->
                        <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{svc:T Obs.SfxHint}" TextWrapping="Wrap" FontSize="11" LineHeight="17"
                                           Foreground="{StaticResource Muted2Brush}"/>
                                <TextBlock Text="{svc:T Obs.CacheHint}" TextWrapping="Wrap" FontSize="11" LineHeight="17"
                                           Margin="0,6,0,0" Foreground="{StaticResource Muted2Brush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Messages from the maker -->
            <Popup PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom" VerticalOffset="4"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{Binding Notices.IsOpen, Mode=TwoWay}">
                <Border Width="440" Padding="14" Margin="0,0,14,14" CornerRadius="6" BorderThickness="1"
                        Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <StackPanel TextElement.Foreground="{StaticResource TextBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,0"
                                    Content="{svc:T Notices.DismissAll}" Command="{Binding DismissAllNoticesCommand}"/>
                            <TextBlock Text="{svc:T Notices.Title}" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Notices.Items}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="14"
                                                       Margin="0,1,10,0" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Body}" Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="{svc:T Notices.Open}" Command="{Binding OpenCommand}"
                                                            Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="{svc:T Notices.Dismiss}" Command="{Binding DismissCommand}"
                                                            Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ========== Sidebar + page ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="0,10">
                        <RadioButton DockPanel.Dock="Bottom" DataContext="{Binding SettingsItem}" GroupName="nav"
                                     Style="{StaticResource NavButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     CommandParameter="{Binding}"/>
                        <!-- Docked after Settings, so it sits just above it -->
                        <RadioButton DockPanel.Dock="Bottom" DataContext="{Binding SupportItem}" GroupName="nav"
                                     Style="{StaticResource NavButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     CommandParameter="{Binding}"/>
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="nav" Style="{StaticResource NavButton}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- A screen fades up as it arrives, so switching reads as a change of place
                     rather than a redraw. 140ms: long enough to see, too short to wait for. -->
                <ContentControl Grid.Column="1" Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                    <ContentControl.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                     From="10" To="0" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ContentControl.Triggers>
                </ContentControl>

                <!-- Starting, or the server is down: nothing else on screen can work. -->
                <Grid Grid.ColumnSpan="2" Background="{StaticResource BgBrush}"
                      Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Width="580" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Visibility="{Binding IsStarting, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{svc:T Startup.Title}" FontSize="14" FontWeight="SemiBold"/>
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,14,0,0" BorderThickness="0"
                                             Background="{StaticResource Surface3Brush}" Foreground="{StaticResource GoldBrush}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource RedBrush}" FontSize="16"/>
                                    <TextBlock Text="{svc:T Error.Title}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBox Text="{Binding StartupError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         MaxHeight="240" Margin="0,14,0,0" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="{svc:T Common.Retry}" Command="{Binding RetryCommand}"
                                        HorizontalAlignment="Left" MinWidth="96" Margin="0,14,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Toasts -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ToastItems}" Width="360" IsHitTestVisible="False"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6,0,0" Padding="12,9" CornerRadius="4" BorderThickness="3,1,1,1"
                                    Background="{StaticResource Surface3Brush}">
                                <!-- Slides in from the edge it lives on. A toast that simply
                                     appears is easy to miss; one that moves is not. -->
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                 From="36" To="0" Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ========== Status bar ========== -->
            <Border Grid.Row="2" Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,0" LastChildFill="False" TextElement.FontSize="11.5">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStarting}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted2Brush}"/>
                    <TextBlock Text="{Binding ServerUrl}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
