<UserControl x:Class="RovOverlay.Desktop.Views.TournamentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services"
             xmlns:ctl="clr-namespace:RovOverlay.Desktop.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="CardHead" TargetType="DockPanel">
            <Setter Property="Margin" Value="14,10,10,10"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="StandCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Gone: deleted elsewhere, or a bad id -->
        <Border Style="{StaticResource Card}" Width="480" Padding="{StaticResource Pad5}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding NotFound, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{svc:T Tour.NotFound}"/>
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding ErrorText}" Margin="0,8,0,14"/>
                <Button HorizontalAlignment="Left" Content="{svc:T Common.Back}" Command="{Binding BackCommand}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding NotFound, Converter={StaticResource BoolToVisInv}}">
            <Grid Margin="22,14,22,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========== Header ========== -->
                <StackPanel>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="6,0" Margin="-6,0,0,4"
                            Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{svc:T Common.Back}"/>
                        </StackPanel>
                    </Button>
                    <WrapPanel>
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border CornerRadius="9" Padding="8,1,8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource GoldSoftBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0"><TextBlock Style="{StaticResource PillText}" Text="{Binding FormatText}"/></Border>
                        <Border Style="{StaticResource Pill}"><TextBlock Style="{StaticResource PillText}" Text="{Binding SeriesText}"/></Border>
                    </WrapPanel>
                </StackPanel>

                <!-- ========== Body: teams on the left, the rest on the right ========== -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- Teams -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Style="{StaticResource CardHead}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleTeamsCommand}"
                                        Content="{Binding TeamsOpen, Converter={StaticResource FoldGlyph}}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                        Command="{Binding ToggleAddCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,7,0"/>
                                        <TextBlock Text="{svc:T Tour.AddTeam}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Tour.Teams}" VerticalAlignment="Center"/>
                                    <Border Margin="10,0,0,0" CornerRadius="9" Padding="8,1,8,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource RedSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding TeamCountText}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Visibility="{Binding TeamsOpen, Converter={StaticResource BoolToVis}}">
                                <!-- Add a team -->
                                <Border Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1"
                                        Padding="14" Visibility="{Binding AddOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Tour.PickExisting}"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                                    Content="{svc:T Tour.AddToTournament}" Command="{Binding AddExistingCommand}"/>
                                            <ComboBox ItemsSource="{Binding Available}" SelectedItem="{Binding Pick}" DisplayMemberPath="Label"
                                                      IsEnabled="{Binding HasAvailable}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding PickerEmptyText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVisInv}}"/>

                                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,14"/>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Tour.OrCreate}" Margin="0,0,0,10"/>
                                        <ctl:NewTeamFormView DataContext="{Binding NewTeam}"/>
                                        <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                            <Button DockPanel.Dock="Right" Content="{svc:T Common.Close}" Command="{Binding CloseAddCommand}"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="{svc:T Tour.CreateAndAdd}" Command="{Binding CreateAndAddCommand}"/>
                                            <Button Content="{svc:T Team.ClearForm}" Command="{Binding ClearNewTeamCommand}" Margin="8,0,0,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- The roster -->
                                <ItemsControl ItemsSource="{Binding Roster}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel>
                                                    <Grid Height="50" Margin="14,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ctl:TeamLogoView Width="32" Height="32" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <Border Style="{StaticResource Pill}" Margin="0,0,5,0" Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding Tag}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource Pill}" Margin="0,0,5,0"><TextBlock Style="{StaticResource PillText}" Text="{Binding SeedText}"/></Border>
                                                                <Border Style="{StaticResource Pill}"><TextBlock Style="{StaticResource PillText}" Text="{Binding PlayersText}"/></Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource GhostButton}" Content="{Binding EditLabel}" Command="{Binding EditCommand}" Padding="10,0"/>
                                                            <Button Style="{StaticResource GhostButton}" Content="{svc:T Common.Profile}" Command="{Binding ProfileCommand}" Padding="10,0"/>
                                                            <Button Style="{StaticResource DangerIconButton}" Content="&#xE711;" Command="{Binding RemoveCommand}"
                                                                    ToolTip="{svc:T Tour.RemoveTip}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                                            Padding="14" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                        <ctl:TeamEditorView DataContext="{Binding Editor}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RosterEmptyText}" Foreground="{StaticResource MutedBrush}" Margin="14,4,14,18"
                                           Visibility="{Binding RosterEmpty, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2">
                        <!-- Match session -->
                        <Border Style="{StaticResource CardHero}" Padding="14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1,8,2"
                                            Visibility="{Binding MatchBadge, Converter={StaticResource NullToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchesComplete}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GoldSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding MatchBadge}"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Tour.MatchSession}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding MatchNote}" Margin="0,8,0,12" LineHeight="18"/>

                                <!-- The matches that can be run now, each with the button the
                                     bracket card has: on air, and straight into the Control
                                     Panel. Without these the only route was the bracket. -->
                                <StackPanel Visibility="{Binding HasNextMatches, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Tour.NextMatches}"/>
                                    <ItemsControl ItemsSource="{Binding NextMatches}" Focusable="False" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                                                Content="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                                Width="28" Height="28" FontSize="12" Padding="0" Margin="8,0,0,0"
                                                                Command="{Binding PlayCommand}" ToolTip="{svc:T Bracket.OnAirTip}"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenBracketCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="0,0,7,0"/>
                                            <TextBlock Text="{svc:T Tour.OpenBracket}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{svc:T Tour.PickBanHistory}" Command="{Binding OpenDraftsCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Standings (round robin and group stage only) -->
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0"
                                Visibility="{Binding ShowStandings, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Tour.Standings}"/>
                                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                    <TextBlock Text="{svc:T Tour.PerGroup}" VerticalAlignment="Center" Foreground="{StaticResource Muted2Brush}"/>
                                    <TextBox Text="{Binding PerGroupText, UpdateSourceTrigger=PropertyChanged}" Width="44" MaxLength="1"
                                             Margin="8,0,0,0" HorizontalContentAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{svc:T Tour.DrawPlayoff}"
                                            Command="{Binding DrawPlayoffCommand}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Tour.StandingsEmpty}" Margin="0,12,0,0"
                                           Visibility="{Binding NoStandings, Converter={StaticResource BoolToVis}}"/>

                                <ItemsControl ItemsSource="{Binding StandingGroups}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,14,0,0">
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <Grid Margin="6,0" TextElement.Foreground="{StaticResource MutedBrush}" TextElement.FontSize="11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="#"/>
                                                    <TextBlock Grid.Column="1" Text="{svc:T Col.Team}"/>
                                                    <TextBlock Grid.Column="2" Text="P" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="W" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="L" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="+/-" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="6" Text="PTS" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="3" Padding="6,0" Height="26" Margin="0,1,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsThrough}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource GoldSoftBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                        <ColumnDefinition Width="38"/>
                                                                        <ColumnDefinition Width="38"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding RankText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                                               FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="2" Style="{StaticResource StandCell}" Text="{Binding Played}"/>
                                                                    <TextBlock Grid.Column="3" Style="{StaticResource StandCell}" Text="{Binding Won}"/>
                                                                    <TextBlock Grid.Column="4" Style="{StaticResource StandCell}" Text="{Binding Lost}"/>
                                                                    <TextBlock Grid.Column="5" Style="{StaticResource StandCell}" Text="{Binding DiffText}"/>
                                                                    <TextBlock Grid.Column="6" Style="{StaticResource StandCell}" Text="{Binding Points}" FontWeight="Bold"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Tour.TiedHint}" FontSize="11" Margin="0,10,0,0"
                                           Visibility="{Binding AnyTied, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Details -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Style="{StaticResource CardHead}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleDetailsCommand}"
                                            Content="{Binding DetailsOpen, Converter={StaticResource FoldGlyph}}"/>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Tour.Details}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Margin="14,0,14,14" Visibility="{Binding DetailsOpen, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Tour.Name}"/>
                                    <TextBox Text="{Binding FName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Home.Format}"/>
                                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding FFormat}" DisplayMemberPath="Label"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Home.BestOf}"/>
                                            <ComboBox ItemsSource="{Binding BestOfChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding FBestOf}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding FormatHint}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FormatHintIsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Tour.Status}" Margin="0,10,0,4"/>
                                    <ComboBox ItemsSource="{Binding StatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding FStatus}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Tour.Note}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding FNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Height="60"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{svc:T Tour.DeleteTournament}"
                                                Command="{Binding DeleteCommand}"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="{svc:T Tour.SaveChanges}" Command="{Binding SaveDetailsCommand}"/>
                                        <Button Content="{svc:T Tour.Revert}" Command="{Binding RevertCommand}" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- This tournament's OBS sources -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Style="{StaticResource CardHead}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleObsCommand}"
                                            Content="{Binding ObsOpen, Converter={StaticResource FoldGlyph}}"/>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Tour.ObsSources}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Margin="14,0,14,14" Visibility="{Binding ObsOpen, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Tour.ObsHint}" FontSize="11.5" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding ObsSources}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" Margin="6,0"
                                                             FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Command="{Binding CopyCommand}" ToolTip="{svc:T Common.Copy}"/>
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Command="{Binding OpenCommand}" ToolTip="{svc:T Common.OpenBrowser}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
