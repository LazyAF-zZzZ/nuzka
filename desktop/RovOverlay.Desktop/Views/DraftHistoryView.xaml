<UserControl x:Class="RovOverlay.Desktop.Views.DraftHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RovOverlay.Desktop.Views.Controls"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services">
    <UserControl.Resources>
        <!-- One side of a recorded draft: the team, then its picks and bans as portraits. -->
        <DataTemplate x:Key="DraftSideTemplate">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlue}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Won}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{svc:T Drafts.Pick}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Width="30"/>
                    <ItemsControl ItemsSource="{Binding Picks}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="42" Height="42" CornerRadius="4" Margin="0,0,4,0" ClipToBounds="True"
                                        Background="{StaticResource Surface3Brush}" BorderThickness="1" ToolTip="{Binding Hero}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </DataTrigger>
                                                <!-- Found by the hero filter -->
                                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding Url, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{svc:T Drafts.Ban}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Width="30" Margin="14,0,0,0"/>
                    <ItemsControl ItemsSource="{Binding Bans}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="34" Height="34" CornerRadius="4" Margin="0,0,4,0" ClipToBounds="True"
                                        Background="{StaticResource Surface3Brush}" BorderThickness="1" ToolTip="{Binding Hero}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding Url, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource Card}" Width="480" Padding="{StaticResource Pad5}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding NotFound, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{svc:T Tour.NotFound}"/>
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding ErrorText}" Margin="0,8,0,14"/>
                <Button HorizontalAlignment="Left" Content="{svc:T Common.Back}" Command="{Binding BackCommand}"/>
            </StackPanel>
        </Border>

        <DockPanel Visibility="{Binding NotFound, Converter={StaticResource BoolToVisInv}}" Margin="22,14,22,0">
            <StackPanel DockPanel.Dock="Top">
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="6,0" Margin="-6,0,0,4"
                        Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="{svc:T Common.Back}"/>
                    </StackPanel>
                </Button>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding TeamFilter}" DisplayMemberPath="Label" Width="200"/>
                        <Grid Width="220" Margin="8,0,0,0">
                            <TextBox Text="{Binding HeroFilter, UpdateSourceTrigger=PropertyChanged}" Padding="28,4,7,4"
                                     Tag="{svc:T Drafts.FindHero}"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Style="{StaticResource GhostButton}" Content="{svc:T Drafts.ClearFilters}" Command="{Binding ClearFiltersCommand}"
                                Margin="6,0,0,0" Padding="10,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
                        <Border Style="{StaticResource Pill}" Margin="10,2,0,0">
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding CountText}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Drafts.Title}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- One cell for both: as DockPanel children the empty state docked to the left edge. -->
            <Grid>
                <ctl:EmptyStateView Glyph="&#xE81C;" Title="{Binding EmptyTitle}" Hint="{Binding EmptyText}"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInv}}">
                    <ItemsControl ItemsSource="{Binding Games}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GameLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Width="170"/>
                                            <TextBlock Text="{Binding Teams}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ContentControl Content="{Binding Blue}" ContentTemplate="{StaticResource DraftSideTemplate}"/>
                                        <ContentControl Content="{Binding Red}" ContentTemplate="{StaticResource DraftSideTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
